digraph C {
graph [rankdir=TB, bgcolor="white", pad=0.2, nodesep=0.35, ranksep=0.6];
node [shape=plain, fontname="Times New Roman", fontsize=10];
edge [fontname="Times New Roman", fontsize=9, color="#555555"];

app [label=<
<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#2F5597" bgcolor="#F7FBFF">
  <tr><td><b>OrderCalculator</b></td></tr>
  <hr/>
  <tr><td align="left"><u>- VAT_RATE : double = 20</u></td></tr>
  <tr><td align="left"><u>- QUANTITY_MAX : int = 10000</u></td></tr>
  <tr><td align="left"><u>- UNIT_PRICE_MAX : double = 5000000</u></td></tr>
  <tr><td align="left"><u>- DISCOUNT_PERCENT_MAX : double = 45</u></td></tr>
  <hr/>
  <tr><td align="left"><u>+ main(String[]) : void</u></td></tr>
  <tr><td align="left"><u>+ isValid(int, double, double) : boolean</u></td></tr>
  <tr><td align="left"><u>+ calculateBase(int, double) : double</u></td></tr>
  <tr><td align="left"><u>+ applyDiscount(double, double) : double</u></td></tr>
  <tr><td align="left"><u>+ calculateVat(double, double) : double</u></td></tr>
  <tr><td align="left"><u>+ calculateTotal(int, double, double, double) : double</u></td></tr>
</table>>];

check [label=<
<table border="1" cellborder="0" cellspacing="0" cellpadding="4" color="#2F5597" bgcolor="#F7FBFF">
  <tr><td><b>SelfCheck</b></td></tr>
  <hr/>
  <tr><td> </td></tr>
  <hr/>
  <tr><td align="left"><u>+ main(String[]) : void</u></td></tr>
  <tr><td align="left"><u>- check(String, boolean) : void</u></td></tr>
</table>>];

check -> app [style=dashed, arrowhead=vee, label=" «use»"];
}
